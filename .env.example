# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Web Server & Health-Check Port (Render, Railway, Fly.io, Heroku, Docker, or local)
PORT=8080
HOST=0.0.0.0

# SSL verification (1 = enabled, set to 0 only if behind a corporate proxy)
SSL_VERIFY=1
